[Unit]
Description=Personal site Vite development server
After=network.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/personal-site
Environment=PATH=/home/exedev/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=DATABASE_PATH=/home/exedev/personal-site/data/site.sqlite
ExecStart=/home/exedev/node/bin/node /home/exedev/personal-site/node_modules/vite/bin/vite.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
